# Persönlicher Garage 61 API Token (Bearer). Erstellung im Garage 61 Account
# unter "My applications".
GARAGE61_TOKEN=

# Optional: Track-ID für Spa-Francorchamps in Garage 61 fest vorgeben.
# Wird die Variable nicht gesetzt, ermittelt die App die ID automatisch.
# GARAGE61_SPA_TRACK_ID=

# Optional: alternative API-Basis-URL (Default: https://garage61.net/api/v1).
# GARAGE61_API_BASE=https://garage61.net/api/v1
